aws_region       = "us-east-1"
project_name     = "pqc-tls-lab"
environment      = "lab"
device_type      = "QDevice"
instance_type    = "t3.micro"
ssh_key_name     = "YOUR_EC2_KEY_PAIR_NAME"
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"
tls_allowed_cidr = "YOUR_PUBLIC_IP/32"

# ECR repository created by Terraform and used by the Docker workflow.
ecr_repository_name = "pqc-tls"

# CloudWatch Logs retention for application and bootstrap log groups.
log_retention_days = 14

# Ubuntu 26.04 LTS latest/current via Canonical public SSM parameter.
ubuntu_series = "resolute"
ubuntu_arch   = "amd64"

# Recommended pipeline order:
# 1) Terraform apply creates VPC, EC2, IAM, CloudWatch Log Groups and ECR.
# 2) Docker workflow validates crypto config with Rego, builds/pushes the image and deploys it to EC2 through SSM.
# 3) Telemetry workflow runs active TLS tests inside EC2 and reads metrics/logs directly from CloudWatch.
