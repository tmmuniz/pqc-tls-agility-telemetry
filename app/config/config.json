{
  "app": {
    "listen_address": "0.0.0.0",
    "listen_port": 8443,
    "message": "hello crypto-agility with OpenSSL EVP and PQC-ready TLS groups",
    "digest_algorithm": "SHA256",
    "cipher_algorithm": "AES-256-GCM"
  },
  "tls": {
    "certificate_file": "server.crt",
    "private_key_file": "server.key",
    "minimum_version": "TLSv1.3",
    "maximum_version": "TLSv1.3",
    "tls12_cipher_list": "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
    "tls13_ciphersuites": "TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256",
    "groups": "X25519MLKEM768:X25519:P-256:P-384",
    "signature_algorithms": "RSA-PSS+SHA256:RSA-PSS+SHA384:ECDSA+SHA256:ECDSA+SHA384"
  },
  "logging": {
    "log_file": "/app/logs/pqc-tls-agility.log"
  }
}
